{
  "name": "100-rads-bar",
  "version": "0.0.1",
  "description": "Official website for 100 Rads Bar",
  "type": "module",
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "client:dev": "npm run dev --workspace=client",
    "client:build": "npm run build --workspace=client",
    "server:dev": "wait-on tcp:5433 && npm run start:dev --workspace=server",
    "start:dev": "concurrently 'npm run docker:up' 'npm run server:dev' 'npm run client:dev'",
    "start:prod": "npm run docker:up && npm run client:build && npm run server:dev",
    "stop": "npm run docker:down",
    "clean": "rm -rf dist"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^9.1.2",
    "esbuild": "^0.25.3",
    "wait-on": "^8.0.3"
  }
}
